# Copy to .env and fill in. NEVER commit .env with real secrets.
DEV_MODE=0
# HOST=127.0.0.1
# PORT=8000
# DATABASE_URL=   # default: <project>/data/base.db (sqlite). Postgres example:
# DATABASE_URL=postgresql+psycopg://rustdesk:rustdesk@localhost:5432/rustdesk_ab
DEVICE_SECRET=    # required: output of `.venv/bin/python -m app.cli gen-key`
WEB_SECRET=       # required: random 32+ chars, e.g. output of `openssl rand -hex 32`
# SESSION_DAYS=30
# MAX_PEER_ONE_AB=0
# Comma-separated reverse-proxy IPs whose X-Forwarded-For may key per-IP rate
# limits (e.g. 127.0.0.1 for Caddy on loopback). Empty = ignore XFF entirely.
# TRUSTED_PROXIES=
# 1 = serve /docs, /redoc and /openapi.json (default 0; auto-on in DEV_MODE).
# EXPOSE_DOCS=0
# SHIM_ENABLED=0
# SHIM_LISTEN=127.0.0.1:21116
# SHIM_UPSTREAM=127.0.0.1:21166   # hbbs rendezvous (hbbs -p 21166). Not a relay TCP 21117!
# SHIM_ID_KEY=    # absolute path to hbbs id_ed25519 (required if SHIM_ENABLED=1)
