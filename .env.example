# Native run: copy to .env and fill in. NEVER commit .env.
# Docker: settings live in docker-compose.yml; a .env next to it is read only
# for DEVICE_SECRET and WEB_SECRET.
#
# Only settings that depend on the installation are listed. Rate limits, shim
# capacity, bcrypt pool and audit internals keep their tuned defaults; the
# full list is in README.md, "Configuration".
# Keep comments on their own lines: `docker run --env-file` would make an
# inline comment part of the value.

# ------------------------------------------------------------------ secrets --
# Required natively (under Docker they may stay empty and are generated).
# Fernet key for stored device passwords; changing it later makes them
# unreadable. Generate: .venv/bin/python -m app.cli gen-key
DEVICE_SECRET=
# Signs the legacy panel cookie; 32+ random chars: openssl rand -hex 32
WEB_SECRET=

# ------------------------------------------------------------------ network --
# HTTP API + panel. Keep 127.0.0.1 behind a reverse proxy on this host.
HOST=127.0.0.1
PORT=8000

# ----------------------------------------------------------------- database --
# Empty = data/base.db. A relative name such as sqlite:///pc-service.db is
# placed in data/. Postgres: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=

# ----------------------------------------------------------------- sessions --
# Days until an API/panel login expires (0 = never, not recommended).
SESSION_DAYS=30
# Panel cookie Secure flag: auto (on HTTPS requests), 1 (always), 0 (never).
SESSION_COOKIE_SECURE=auto
# Devices per address book (0 = unlimited).
MAX_PEER_ONE_AB=0

# ------------------------------------------------------------ reverse proxy --
# Comma-separated reverse-proxy IPs whose X-Forwarded-For is trusted
# (e.g. 127.0.0.1 for Caddy on loopback). Empty = ignore X-Forwarded-For.
TRUSTED_PROXIES=

# --------------------------------------------------------------------- shim --
# 1 = terminate KeyExchange for logged-in clients.
SHIM_ENABLED=0
# Where clients connect (TCP and UDP).
SHIM_LISTEN=0.0.0.0:21116
# The real hbbs rendezvous, never the relay 21117. Same host: start hbbs with
# -p 21166. Another machine: <hbbs-host>:21116
SHIM_UPSTREAM=127.0.0.1:21166
# Absolute path to the hbbs PRIVATE id_ed25519 (not the .pub).
SHIM_ID_KEY=
# Devices seen by the shim appear in the panel as "discovered".
DISCOVERY_ENABLED=1

# -------------------------------------------------------------------- audit --
# 0 disables the event log (/audit in the panel).
AUDIT_ENABLED=1
# Days to keep events; clamped to 30..90.
AUDIT_RETENTION_DAYS=90

# ------------------------------------------------------------------ logging --
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------- API docs --
# 1 = serve /docs, /redoc and /openapi.json (full API inventory).
# Keep 0 in production (SEC-008).
EXPOSE_DOCS=0
