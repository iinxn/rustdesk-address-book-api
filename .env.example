# Copy to .env and fill in. NEVER commit .env with real secrets.
DEV_MODE=0
HOST=127.0.0.1
PORT=8000
DATABASE_URL=   # default: <project>/data/base.db (sqlite). Postgres example:
# DATABASE_URL=postgresql+psycopg://rustdesk:rustdesk@localhost:5432/rustdesk_ab
DEVICE_SECRET=    # required: output of `.venv/bin/python -m app.cli gen-key`
WEB_SECRET=       # required: random 32+ chars, e.g. output of `openssl rand -hex 32`
# SESSION_DAYS=30
# Panel cookie Secure flag: auto (HTTPS requests only), 1 (always), 0 (never).
# SESSION_COOKIE_SECURE=auto
# bcrypt runs in its own pool; logins beyond the queue get 429 (not queued).
# PASSWORD_HASH_WORKERS=2
# PASSWORD_HASH_QUEUE=8
# MAX_PEER_ONE_AB=0
# Heartbeat limits. Per-device bucket defaults to 20/min (client sends ~4/min).
# Per-IP is an aggregate cap: 800 devices behind one NAT at 15s ≈ 3200/min.
# HEARTBEAT_PER_MINUTE_PER_DEVICE=20
# HEARTBEAT_PER_MINUTE_PER_IP=6000
# Sysinfo uploads: the client sends one at startup (and again after a Windows
# user logs in). Duplicates are acked without rewriting the DB; the cap covers
# a first-boot burst of the whole fleet.
# SYSINFO_PER_MINUTE_PER_IP=6000
# Comma-separated reverse-proxy IPs whose X-Forwarded-For may key per-IP rate
# limits (e.g. 127.0.0.1 for Caddy on loopback). Empty = ignore XFF entirely.
# TRUSTED_PROXIES=
# 1 = serve /docs, /redoc and /openapi.json (default 0; auto-on in DEV_MODE).
EXPOSE_DOCS=0
SHIM_ENABLED=0
SHIM_LISTEN=0.0.0.0:21116
SHIM_UPSTREAM=127.0.0.1:21116   # hbbs rendezvous (hbbs -p 21166). Not a relay TCP 21117!
SHIM_ID_KEY=    # absolute path to hbbs id_ed25519 (required if SHIM_ENABLED=1)
# UDP rendezvous budget (separate from TCP SHIM_MAX_CONNS/SHIM_PER_IP_PER_MIN):
# ~one session per device; many devices may share one NAT address.
# SHIM_UDP_MAX_SESSIONS=2048
# SHIM_UDP_PER_IP_PER_MIN=600
